# FlowPilot AI Server Environment Configuration
NODE_ENV=development
PORT=5000

# ==============================================================================
# DATABASE CONNECTION (SQLite for Local Dev OR Supabase PostgreSQL)
# ==============================================================================
# For local development with persistent zero-config SQLite:
DATABASE_URL="file:./dev.db"

# To connect to Supabase PostgreSQL:
# 1. In Supabase Dashboard -> Project Settings -> Database -> Connection string:
#    DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
#    DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
# 2. Run: npm run prisma:supabase:push && npm run seed

DIRECT_URL=""

# ==============================================================================
# SUPABASE API CREDENTIALS (Optional for direct SDK access / storage)
# ==============================================================================
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ==============================================================================
# SECURITY & AUTHENTICATION
# ==============================================================================
JWT_SECRET="flowpilot-super-secure-jwt-secret-key-change-in-production-2026"
COOKIE_SECRET="flowpilot-cookie-secret-random-hex-string-2026"
FRONTEND_URL="http://localhost:5173"

# ==============================================================================
# AI INTELLIGENCE ENGINE (Google Gemini API)
# ==============================================================================
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
AI_MODEL="gemini-2.5-flash"
ENABLE_DEMO_MODE=true
LOG_LEVEL="debug"
